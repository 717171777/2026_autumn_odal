DATABASE_URL=postgresql://odal:odal_local_only@localhost:5438/odal
# Vercel: use the pooled PostgreSQL URL from Neon; never commit a real URL.
# DATABASE_URL_UNPOOLED=postgresql://... (optional, for migrations)
# Separate random secret, at least 32 characters, for hashing authentication rate-limit keys.
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
